# Pinned inputs of the closed-loop experiment. Sourced by every script here.
# Account-specific values (bucket names, instance IDs) stay in the repo-root
# .env, not in this file.

# AlpaSim checkout the driver plugin is built into.
ALPASIM_REPO=https://github.com/NVlabs/alpasim.git
ALPASIM_COMMIT=affc2eab209fa43bdfa2f26c0f8d437922d78a68
ALPASIM_ROOT=${ALPASIM_ROOT:-$HOME/alpasim}

# Driver image built from the checkout above with the autoe2e extra.
ALPASIM_BASE_IMAGE=alpasim-base:autoe2e-${ALPASIM_COMMIT:0:12}

# nuPlan Epoch 5 (trajectory + route) checkpoint. The plugin's nuPlan rig
# profile matches the cameras it was trained on.
CHECKPOINT_SHA256=ca8b43d7a777d6fd9195bb253d1452f3cd645f7aab3bd0e36b1f74ffb31df29b
CHECKPOINT_S3_KEY=autoe2e/checkpoints/${CHECKPOINT_SHA256}.pt

# NVIDIA rig scenes, re-rendered with the nuPlan cameras by driver=autoe2e_nuplan.
DRIVER_CONFIG=autoe2e_nuplan
TOPOLOGY=1gpu
